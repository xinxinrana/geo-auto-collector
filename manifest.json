{
  "manifest_version": 3,
  "name": "GEO 自动采集",
  "version": "0.1.0",
  "description": "自动检测关键词在 AI 搜索平台的内容表现，采集正文/引用/DOM/截图并导出。",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "GEO 自动采集"
  },
  "icons": {
    "16": "src/popup/icon.png",
    "48": "src/popup/icon.png",
    "128": "src/popup/icon.png"
  }
}
