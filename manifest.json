{
  "manifest_version": 3,
  "name": "GEO 采集助手",
  "version": "0.8.2",
  "minimum_chrome_version": "120",
  "description": "在已登录的 AI 对话页面（Perplexity、豆包）采集回答与引用，通过本机 HTTP 和 CLI 交付给 Agent。",
  "permissions": ["scripting", "storage", "alarms", "sidePanel", "debugger"],
  "host_permissions": ["https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://www.doubao.com/*", "https://doubao.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "extension/background.js", "type": "module" },
  "action": { "default_title": "打开 GEO 采集助手" },
  "side_panel": { "default_path": "extension/panel.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*"
  }
}
